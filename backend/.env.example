# Copie este arquivo para .env e preencha com seus valores
PORT=3000

# Banco de dados (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=arremessandoAlto

# Chave secreta para gerar os tokens JWT (use um texto longo e aleatório)
JWT_SECRET=troque_por_uma_chave_secreta

# Cloudinary (painel do Cloudinary > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_UPLOAD_PRESET=seu_upload_preset
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret